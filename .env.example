APP_NAME="Community Resource Directory"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# Database — from hPanel → Databases → MySQL Databases.
# Hostinger prefixes both the database and the user, e.g. u123456789_appdb.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Queue. `sync` runs jobs inside the web request — the "Manual URL and email
# Verification" button dispatches a job that pings every organization's site,
# which will exceed max_execution_time. Use `database` plus the cron worker
# described in DEPLOYMENT.md.
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=database

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
BROADCAST_DRIVER=log

# ---------------------------------------------------------------------------
# Mail — hPanel → Emails → Email Accounts. Use the SMTP host it shows you.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# This application's own keys. None of these were in the stock .env.example.
# All are read through config/services.php, so they survive `config:cache`.
# ---------------------------------------------------------------------------

# Maps on the public search and organization pages. Without it the map island
# mounts and stays blank.
GOOGLE_MAP_API_KEY=

# reCAPTCHA v3 — the suggest-a-resource, contact and spam-report forms mint a
# token at submit time and the server verifies it. Leave both blank only if you
# have also relaxed the server-side check.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Kickbox email verification, used by the organization validation job.
# Optional: when empty the job skips the email check and only pings websites.
KICKBOX_API_KEY=

# Destination of the "Blog" link in the public header. Renders href="" if unset.
BLOG_URL=

# Shared secret for the WordPress auth cookie. Only needed if you are actually
# running the companion WordPress site — see the security note in
# ARCHITECTURE.md before enabling this.
API_VERIFICATION_TOKEN=

# Shown in the admin footer.
APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# The `wordpress` database connection in config/database.php is not referenced
# by any application code. Leave these unset; the connection is lazy and will
# never be opened.
# ---------------------------------------------------------------------------
# WP_DB_HOST=
# WP_DB_DATABASE=
# WP_DB_USERNAME=
# WP_DB_PASSWORD=
# WP_DB_PREFIX=wp_
